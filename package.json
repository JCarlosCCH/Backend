{
  "name": "gestor-de-tareas-backend",
  "version": "1.0.0",
  "description": "Base técnica de la API Gestor de Tareas para la I. E. Rey Josías",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings=0",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand test/unit",
    "test:e2e": "jest --runInBand test/e2e",
    "db:check": "ts-node src/database/check-connection.ts",
    "db:export:sqlserver": "powershell -NoProfile -File scripts/export-sqlserver.ps1",
    "db:import:postgres": "node scripts/import-postgres.cjs",
    "db:bundle:render": "node scripts/bundle-render.cjs",
    "start:render": "node scripts/bootstrap-render.cjs && node dist/main",
    "auth:prepare-dev": "ts-node scripts/prepare-auth-dev.ts",
    "auth:seed-dev": "pwsh -NoProfile -File scripts/seed-auth-dev.ps1",
    "auth:rotate-dev": "pwsh -NoProfile -File scripts/rotate-auth-dev.ps1",
    "core:prepare-dev": "ts-node scripts/prepare-core-dev.ts",
    "core:seed-dev": "pwsh -NoProfile -File scripts/seed-core-dev.ps1",
    "d1:inspect": "pwsh -NoProfile -File scripts/seed-primaria-dev.ps1 -Mode DryRun",
    "d1:apply": "pwsh -NoProfile -File scripts/seed-primaria-dev.ps1 -Mode Apply",
    "d1:verify": "ts-node scripts/verify-primaria-http.ts",
    "d1:test": "pwsh -NoProfile -File scripts/test-d1-guards.ps1",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "7.4.2",
    "@nestjs/throttler": "5.2.0",
    "@nestjs/typeorm": "^10.0.0",
    "argon2": "0.45.1",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "16.6.1",
    "mssql": "12.7.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "typeorm": "^0.3.17"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/passport-jwt": "^3.0.9",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/eslint-plugin": "8.46.0",
    "@typescript-eslint/parser": "8.46.0",
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "supertest": "7.3.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.(spec|e2e-spec)\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}
