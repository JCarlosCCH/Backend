NODE_ENV=development
PORT=5000
DB_TYPE=mssql

# Conexión de la aplicación con autenticación SQL Server.
# Indique DB_PORT o DB_INSTANCE según su instalación; no configure ambos.
DB_HOST=
DB_PORT=
DB_INSTANCE=
DB_NAME=GestorTareasDB
DB_USER=gestor_tareas_app
DB_PASSWORD=
DB_ENCRYPT=true
# true solo para desarrollo local si el certificado no es verificable.
DB_TRUST_SERVER_CERTIFICATE=false

# Genere un secreto aleatorio local de al menos 32 bytes; no lo versione.
JWT_SECRET=
JWT_EXPIRES_IN=1800

# Render PostgreSQL: configure DB_TYPE=postgres, DATABASE_URL y DB_SSL=require
# con la Internal Database URL dentro de Render. Para acceso externo desde la
# PC, use External Database URL con DB_SSL=verify-full en .env.render.local.
